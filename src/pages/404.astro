---
import Layout from "../layouts/Layout.astro";

const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;
const homeUrl = baseUrl || "/";
---

<Layout title="404 - Page Not Found" showPreloader={false}>
  <div class="min-h-[calc(100vh-4rem)] flex items-center justify-center py-10 w-full relative z-10">
    <div class="w-full max-w-xl mx-auto space-y-6 sm:space-y-8 p-7 sm:p-10 md:p-12 rounded-3xl bg-[#121215]/85 border border-[#ffffff15] backdrop-blur-2xl shadow-2xl text-center grain-surface">
      <div class="space-y-3">
        <h1 class="text-6xl sm:text-8xl md:text-9xl font-mono font-bold tracking-tight text-[var(--sec)] shiny-sec leading-none select-none">
          404
        </h1>
        <h2 class="text-2xl sm:text-3xl font-semibold text-[var(--white)] tracking-tight">
          Page Lost in Latent Space
        </h2>
        <p class="text-sm sm:text-base text-[var(--white-icon)] max-w-md mx-auto leading-relaxed">
          The requested coordinate does not exist, has been archived, or was moved.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <a
          href={homeUrl}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[var(--sec)] text-[#09090b] font-semibold text-sm hover:bg-[#859cb6] apple-btn magnetic-btn cursor-pointer transition-all duration-300 will-change-transform"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 pointer-events-none">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          <span>Go Back to Main Page</span>
        </a>

        <a
          href={`${homeUrl === "/" ? "" : homeUrl}/#contact`}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-[var(--white-icon-tr)] bg-[#1c1c209c] text-[var(--white-icon)] hover:bg-[var(--white-icon-tr)] hover:border-[#6C839C]/40 font-medium text-sm apple-btn magnetic-btn cursor-pointer transition-all duration-300 will-change-transform"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 pointer-events-none">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          <span>Contact Me</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
