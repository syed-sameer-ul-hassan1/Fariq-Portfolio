---
const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;
---

<section id="about" class="min-h-screen lg:h-screen flex items-center justify-center py-16 md:py-20 border-t border-[#ffffff10] text-[var(--white)] relative">
  <div class="max-w-5xl mx-auto w-full flex flex-col justify-evenly h-full space-y-8 md:space-y-12">
    <div class="reveal-init scroll-heading">
      <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Introduction</h2>
      <h3 class="text-4xl md:text-5xl font-medium">About Me</h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 lg:gap-16 items-center">
      <div class="md:col-span-5 flex justify-center md:justify-start">
        <div class="w-full max-w-[320px] md:max-w-[360px] aspect-[3/4] rounded-3xl overflow-hidden border border-[var(--white-icon-tr)] bg-[#1414149c] shadow-2xl relative">
          <img
            src={`${baseUrl}/Img/Syed-Fariq-Ali-Shah.jpeg`}
            alt="Syed Fariq Ali Shah"
            class="w-full h-full object-cover object-center filter contrast-[1.05] brightness-[0.94] saturate-[0.88]"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-[#6C839C]/15 mix-blend-color pointer-events-none"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--background)] via-[var(--background)]/20 to-transparent opacity-70 pointer-events-none"></div>
          <div class="absolute inset-0 ring-1 ring-inset ring-[var(--white-icon-tr)] rounded-3xl pointer-events-none"></div>
        </div>
      </div>

      <div class="md:col-span-7 space-y-6 text-left about-text-content">
        <p class="text-lg md:text-xl lg:text-2xl text-[var(--white-icon)] leading-relaxed font-normal reveal-init stagger-2">
          Data Science undergraduate at <span class="text-[var(--white)] font-medium">PAF-IAST</span> building practical software and machine learning solutions with <span class="text-[var(--sec)] font-medium">Python, C++, Flask, and SQL</span>. Passionate about engineering reliable, data-driven technology.
        </p>

        <div class="pt-2 flex items-center gap-4 flex-wrap reveal-init stagger-3">
          <a
            href={`${baseUrl}/resume.pdf`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 md:px-6 md:py-3.5 rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c] text-[var(--white-icon)] hover:bg-[var(--white-icon-tr)] apple-btn magnetic-btn font-medium text-base will-change-transform"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 pointer-events-none">
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
              <polyline points="14 2 14 8 20 8"/>
              <path d="M12 18v-6"/>
              <path d="m9 15 3 3 3-3"/>
            </svg>
            <span>Resume</span>
          </a>

          <a
            href="#contact"
            class="inline-flex items-center gap-2 px-5 py-3 md:px-6 md:py-3.5 rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c] text-[var(--white-icon)] hover:bg-[var(--white-icon-tr)] apple-btn magnetic-btn font-medium text-base will-change-transform"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 pointer-events-none">
              <path d="M21.7267 2.95694L16.2734 22.0432C16.1225 22.5716 15.7979 22.5956 15.5563 22.1126L11 13L1.9229 9.36919C1.41322 9.16532 1.41953 8.86022 1.95695 8.68108L21.0432 2.31901C21.5716 2.14285 21.8747 2.43866 21.7267 2.95694ZM19.0353 5.09647L6.81221 9.17085L12.4488 11.4255L15.4895 17.5068L19.0353 5.09647Z"></path>
            </svg>
            <span>Contact Me</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
