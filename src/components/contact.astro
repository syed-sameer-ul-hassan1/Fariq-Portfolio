---

---

<section
  id="contact"
  class="w-full min-h-screen py-20 md:py-28 border-t border-[#ffffff10] text-[var(--white)] relative"
>
  <div class="max-w-5xl mx-auto w-full flex flex-col justify-center space-y-12">
    <div class="space-y-3 scroll-heading">
      <h2
        class="text-lg text-[var(--sec)] shiny-sec font-mono uppercase tracking-wider"
      >
        Contact
      </h2>
      <h3 class="text-4xl md:text-6xl font-semibold tracking-tight text-pretty">
        Let's build something <span class="text-[var(--sec)] shiny-sec"
          >remarkable</span
        > together.
      </h3>
      <p
        class="text-[var(--white-icon)] text-base md:text-lg max-w-xl leading-relaxed"
      >
        Have a challenging machine learning problem, a software idea, or an
        engineering role? Drop a message or reach out directly.
      </p>
    </div>

    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-14 items-start contact-grid-group"
    >
      <div class="lg:col-span-5 space-y-6">
        <a
          href="mailto:fariq@orildo.dev"
          class="group block p-6 rounded-2xl border border-[var(--white-icon-tr)] bg-[#14141480] hover:bg-[var(--white-icon-tr)] hover:border-[#6C839C]/40 transition-all duration-300 apple-card"
        >
          <div class="flex items-center justify-between mb-3">
            <span
              class="text-xs font-mono uppercase tracking-wider text-[var(--white-icon)]"
              >Direct Email</span
            >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4 text-[var(--sec)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300"
            >
              <path d="M7 17L17 7"></path>
              <path d="M7 7h10v10"></path>
            </svg>
          </div>
          <p class="text-lg md:text-xl font-medium text-[var(--white)]">
            syedfariq4477@gmail.com
          </p>
          <span class="text-xs text-[var(--white-icon)] mt-1 block"
            >Usually responds within 24 hours</span
          >
        </a>

        <div
          class="p-6 rounded-2xl border border-[var(--white-icon-tr)] bg-[#14141480] space-y-3 apple-card"
        >
          <span
            class="text-xs font-mono uppercase tracking-wider text-[var(--white-icon)]"
            >Time Zone</span
          >
          <div class="flex items-center gap-2.5">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5 text-[var(--sec)]"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span class="text-base text-[var(--white)] font-medium"
              >UTC+05:00</span
            >
          </div>
        </div>

        <div
          class="p-6 rounded-2xl border border-[var(--white-icon-tr)] bg-[#14141480] space-y-4 apple-card"
        >
          <span
            class="text-xs font-mono uppercase tracking-wider text-[var(--white-icon)]"
            >Connect Directly</span
          >
          <div class="flex items-center gap-2.5 flex-wrap">
            <a
              href="https://wa.me/+923478319852"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-[var(--white-icon-tr)] bg-[#1c1c209c] text-[var(--white-icon)] hover:bg-[var(--white-icon-tr)] hover:border-[#6C839C]/40 apple-btn magnetic-btn text-sm font-medium will-change-transform"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-4 pointer-events-none"
              >
                <path
                  d="M12.004 2C6.48 2 2 6.48 2 12.004c0 1.85.503 3.585 1.38 5.074L2 22.004l5.088-1.332A9.957 9.957 0 0 0 12.004 22c5.523 0 10.004-4.48 10.004-9.996C22.008 6.48 17.527 2 12.004 2zm0 18.2a8.16 8.16 0 0 1-4.223-1.173l-.303-.18-3.024.792.807-2.946-.197-.314A8.188 8.188 0 0 1 3.8 12.004c0-4.524 3.68-8.2 8.204-8.2 4.523 0 8.2 3.676 8.2 8.2 0 4.524-3.677 8.2-8.2 8.2zm4.498-6.14c-.247-.123-1.46-.72-1.687-.803-.227-.082-.392-.123-.557.124-.165.247-.64.803-.784.968-.144.165-.288.185-.535.062-.247-.124-1.042-.384-1.986-1.226-.735-.656-1.232-1.466-1.376-1.713-.144-.247-.015-.38.109-.503.111-.111.247-.288.371-.432.123-.144.165-.247.247-.412.082-.165.041-.309-.021-.432-.062-.124-.556-1.339-.762-1.833-.2-.482-.403-.417-.556-.425l-.474-.008c-.165 0-.432.062-.658.309-.227.247-.866.845-.866 2.06 0 1.215.886 2.39 1.01 2.555.123.165 1.743 2.662 4.223 3.733.59.255 1.05.408 1.41.522.593.188 1.133.161 1.56.097.476-.071 1.46-.597 1.666-1.173.206-.576.206-1.07.144-1.173-.062-.103-.227-.165-.474-.288z"
                ></path>
              </svg>
              <span>WhatsApp</span>
            </a>

            <a
              href="https://discord.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-[var(--white-icon-tr)] bg-[#1c1c209c] text-[var(--white-icon)] hover:bg-[var(--white-icon-tr)] hover:border-[#6C839C]/40 apple-btn magnetic-btn text-sm font-medium will-change-transform"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-4 pointer-events-none"
              >
                <path
                  d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
                ></path>
              </svg>
              <span>Discord</span>
            </a>

            <a
              href="https://instagram.com/syedfariq_77/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-[var(--white-icon-tr)] bg-[#1c1c209c] text-[var(--white-icon)] hover:bg-[var(--white-icon-tr)] hover:border-[#6C839C]/40 apple-btn magnetic-btn text-sm font-medium will-change-transform"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-4 pointer-events-none"
              >
                <path
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                ></path>
              </svg>
              <span>Instagram</span>
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div
          class="p-8 md:p-10 rounded-3xl border border-[#ffffff15] bg-[#121215]/85 backdrop-blur-xl shadow-2xl relative grain-surface"
        >
          <form
            id="contact-form"
            action="https://formspree.io/f/xaeegwyw"
            method="POST"
            class="space-y-6"
          >
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div class="space-y-2">
                <label
                  for="from_name"
                  class="block text-xs font-mono uppercase tracking-wider text-[var(--white-icon)]"
                  >Your Name</label
                >
                <input
                  id="from_name"
                  type="text"
                  name="from_name"
                  placeholder="e.g. Alex Carter"
                  required
                  class="w-full px-4 py-3.5 text-base bg-[#18181c] text-[var(--white)] border border-[#ffffff12] rounded-xl focus:outline-none focus:border-[var(--sec)] focus:ring-1 focus:ring-[var(--sec)] transition-all duration-300 placeholder:text-neutral-600 apple-input"
                />
              </div>

              <div class="space-y-2">
                <label
                  for="reply_to"
                  class="block text-xs font-mono uppercase tracking-wider text-[var(--white-icon)]"
                  >Email Address</label
                >
                <input
                  id="reply_to"
                  type="email"
                  name="reply_to"
                  placeholder="syedfariq4477@gmail.com"
                  required
                  class="w-full px-4 py-3.5 text-base bg-[#18181c] text-[var(--white)] border border-[#ffffff12] rounded-xl focus:outline-none focus:border-[var(--sec)] focus:ring-1 focus:ring-[var(--sec)] transition-all duration-300 placeholder:text-neutral-600 apple-input"
                />
              </div>
            </div>

            <div class="space-y-2">
              <label
                for="contact_message"
                class="block text-xs font-mono uppercase tracking-wider text-[var(--white-icon)]"
                >Your Message</label
              >
              <textarea
                id="contact_message"
                name="message"
                placeholder="Tell me about your project, problem statement, or idea..."
                rows="6"
                required
                class="w-full px-4 py-3.5 text-base bg-[#18181c] text-[var(--white)] border border-[#ffffff12] rounded-xl focus:outline-none focus:border-[var(--sec)] focus:ring-1 focus:ring-[var(--sec)] resize-none transition-all duration-300 placeholder:text-neutral-600 apple-input"
              ></textarea>
            </div>

            <button
              id="contact-submit-btn"
              type="submit"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 text-base font-medium rounded-xl border border-[var(--white-icon-tr)] bg-[var(--white-icon-tr)] hover:bg-[var(--sec)] hover:border-[var(--sec)] text-[var(--white)] transition-all duration-300 apple-btn magnetic-btn will-change-transform group cursor-pointer"
            >
              <span>Transmit Message</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4 pointer-events-none group-hover:translate-x-1 transition-transform duration-300"
              >
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </form>

          <div id="form-message" class="hidden py-8 text-center space-y-3">
            <div
              class="inline-flex items-center justify-center size-12 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-2"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-6"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <h4 class="text-xl font-semibold text-[var(--white)]">
              Message Transmitted
            </h4>
            <p class="text-sm text-[var(--white-icon)] max-w-sm mx-auto">
              Thank you for getting in touch. I will review your message and
              reply promptly.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module" is:inline>
  const form = document.getElementById("contact-form");
  const formMessage = document.getElementById("form-message");

  if (form && formMessage) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById("contact-submit-btn");
      if (submitBtn) {
        submitBtn.setAttribute("disabled", "true");
        submitBtn.classList.add("opacity-60");
      }

      const formData = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });
        if (response.ok) {
          form.reset();
          form.style.display = "none";
          formMessage.classList.remove("hidden");
        } else {
          const data = await response.json();
          console.error("Error response:", data);
          alert(
            "There was a problem sending your message. Please reach out directly via email.",
          );
          if (submitBtn) {
            submitBtn.removeAttribute("disabled");
            submitBtn.classList.remove("opacity-60");
          }
        }
      } catch (error) {
        console.error("Error:", error);
        alert(
          "There was a problem sending your message. Please reach out directly via email.",
        );
        if (submitBtn) {
          submitBtn.removeAttribute("disabled");
          submitBtn.classList.remove("opacity-60");
        }
      }
    });
  }
</script>
