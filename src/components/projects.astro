---

interface Project {
  title: string;
  image: string;
  link: string;
  preview: string;
  status: string;
}

const projects: Project[] = [
  {
    title: "Project One",
    image: "https://placehold.co/600x400/1a1a1a/ffffff?text=Project+One",
    link: "https://github.com/Syed-fariq-ali-shah/",
    preview: "#!",
    status: "Deployed",
  },
  {
    title: "Project Two",
    image: "https://placehold.co/600x400/1a1a1a/ffffff?text=Project+Two",
    link: "https://github.com/Syed-fariq-ali-shah/",
    preview: "#!",
    status: "On Development",
  },
  {
    title: "Project Three",
    image: "https://placehold.co/600x400/1a1a1a/ffffff?text=Project+Three",
    link: "https://github.com/Syed-fariq-ali-shah/",
    preview: "#!",
    status: "Contributor",
  },
  {
    title: "Project Four",
    image: "https://placehold.co/600x400/1a1a1a/ffffff?text=Project+Four",
    link: "https://github.com/Syed-fariq-ali-shah/",
    preview: "#!",
    status: "Deployed",
  },
];
---

<section
  id="projects"
  class="min-h-screen lg:h-screen flex items-center justify-center py-16 md:py-20 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto w-full flex flex-col justify-evenly h-full">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6 md:mb-8 reveal-init scroll-heading">
      <div>
        <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
        <h3 class="text-3xl md:text-5xl font-medium">Projects</h3>
      </div>
      <a
        target="_blank"
        href="https://github.com/Syed-fariq-ali-shah-bit/"
        aria-label="GitHub"
        class="inline-flex items-center gap-2 self-start sm:self-auto text-[var(--white-icon)] transition duration-300 ease-in-out border border-[var(--white-icon-tr)] px-4 py-2 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] apple-btn magnetic-btn text-sm md:text-base whitespace-nowrap will-change-transform"
      >
        <span>More projects on</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-5 pointer-events-none"
        >
          <path
            d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
          ></path>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {
        projects.map((project, idx) => (
          <div class={`group reveal-init stagger-${idx + 1} project-card-item`}>
            <div class="block">
              <a
                href={project.preview}
                target="_blank"
                rel="noopener noreferrer"
                class="block rounded-2xl overflow-hidden shadow-lg border border-[var(--white-icon-tr)] apple-card mb-3 md:mb-4"
              >
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-40 md:h-56 lg:h-60 object-cover group-hover:scale-105 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
                />
              </a>
              <div class="flex items-center px-3">
                <div class="flex-grow">
                  <a
                    href={project.preview}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-[var(--sec)] transition-colors"
                  >
                    <h4 class="text-xl md:text-2xl font-semibold text-[var(--white)]">{project.title}</h4>
                  </a>
                  <span class="py-1 text-sm text-[var(--white-icon)]">
                    {project.status}
                  </span>
                </div>
                <div class="flex gap-2 ml-auto">
                  <a
                    target="_blank"
                    href={project.link}
                    aria-label="GitHub"
                    class="size-11 md:size-14 flex justify-center items-center text-[var(--white-icon)] transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-2.5 md:p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)] apple-btn magnetic-btn will-change-transform"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-5 md:size-7 pointer-events-none"
                    >
                      <path d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z" />
                    </svg>
                  </a>
                  <a
                    target="_blank"
                    href={project.preview}
                    aria-label="Preview"
                    class="size-11 md:size-14 flex justify-center items-center text-[var(--white-icon)] transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-2.5 md:p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)] apple-btn magnetic-btn will-change-transform"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-5 md:size-7 pointer-events-none"
                    >
                      <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
