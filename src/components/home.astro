---
import BackgroundAnimation from "../React/BackgroundAnimation.tsx";
---

<section class="text-[var(--white)] relative min-h-screen flex items-center justify-center overflow-hidden" id="home">
  <BackgroundAnimation client:load />
  <div class="max-w-5xl mx-auto w-full py-12 text-left space-y-6 relative z-10">
    <div class="overflow-hidden">
      <p class="text-md md:text-xl text-[var(--white-icon)] shiny-white font-medium hero-fade-item">
        Hi, I'm Syed Fariq Ali Shah
      </p>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-center space-y-4 lg:space-y-0 lg:space-x-8 md:gap-4">
      <h1 class="hero-title text-[var(--sec)] text-5xl md:text-7xl lg:text-8xl font-semibold text-pretty leading-none tracking-tight">
        <span class="block overflow-hidden pb-1">
          <span class="block hero-line-inner">Data</span>
        </span>
        <span class="block overflow-hidden pb-1">
          <span class="block hero-line-inner">Scientist</span>
        </span>
      </h1>
      <p class="text-lg md:text-2xl lg:text-3xl text-[var(--white-icon)] leading-relaxed max-w-xl min-h-[5rem] md:min-h-[6rem] flex items-center hero-fade-item typewriter-container">
        <span>
          <span id="typewriter-text"></span><span class="typewriter-cursor inline-block text-[var(--sec)] ml-0.5 font-light animate-pulse">|</span>
