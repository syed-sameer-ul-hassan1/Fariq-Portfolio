</section>

<script>
  const textElement = document.getElementById("typewriter-text");

  const sentences = [
    {
      prefix: "Undergraduate at ",
      highlight: "PAF-IAST",
      rest: " — turning ideas into practical software solutions."
    },
    {
      prefix: "I build ",
      highlight: "Python & Machine Learning",
      rest: " applications to solve real-world problems."
    }
  ];

  let sentenceIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  let timer: ReturnType<typeof setTimeout> | null = null;
  const typingSpeed = 38;
  const backspaceSpeed = 20;
  const holdTime = 2400;

  function renderCurrentText(sIdx: number, cIdx: number) {
    if (!textElement) return;
    const current = sentences[sIdx];
    const prefixLen = current.prefix.length;
    const highlightLen = current.highlight.length;

    if (cIdx <= prefixLen) {
      textElement.textContent = current.prefix.slice(0, cIdx);
    } else if (cIdx <= prefixLen + highlightLen) {
      const hPortion = current.highlight.slice(0, cIdx - prefixLen);
      textElement.innerHTML = `${current.prefix}<span class="text-[var(--sec)] shiny-sec font-medium">${hPortion}</span>`;
    } else {
      const rPortion = current.rest.slice(0, cIdx - prefixLen - highlightLen);
      textElement.innerHTML = `${current.prefix}<span class="text-[var(--sec)] shiny-sec font-medium">${current.highlight}</span>${rPortion}`;
    }
  }

  function getFullLength(sIdx: number) {
    const s = sentences[sIdx];
    return s.prefix.length + s.highlight.length + s.rest.length;
  }

  function step() {
    if (!textElement) return;

    const fullLen = getFullLength(sentenceIndex);
    let nextDelay = typingSpeed;

    if (!isDeleting) {
      charIndex++;
      renderCurrentText(sentenceIndex, charIndex);

      if (charIndex >= fullLen) {
        isDeleting = true;
        nextDelay = holdTime;
      }
    } else {
      charIndex--;
      renderCurrentText(sentenceIndex, charIndex);
      nextDelay = backspaceSpeed;

      if (charIndex <= 0) {
        isDeleting = false;
        sentenceIndex = (sentenceIndex + 1) % sentences.length;
        nextDelay = 450;
      }
    }

    timer = setTimeout(step, nextDelay);
  }

  let hasStarted = false;
  function startTypewriter() {
    if (hasStarted) return;
    hasStarted = true;
    if (timer) clearTimeout(timer);
    step();
  }

  window.addEventListener("hero-entrance-start", () => {
    setTimeout(startTypewriter, 350);
  });

  const preloader = document.getElementById("site-preloader");
  if (!preloader || preloader.style.display === "none") {
    setTimeout(startTypewriter, 500);
  } else {
    setTimeout(startTypewriter, 2600);
  }
</script>
