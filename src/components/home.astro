      <a
        target="_blank"
        href="mailto:syedfariq4477@gmail.com"
        aria-label="Email"
        class="text-[var(--white-icon)] transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 md:p-3.5 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)] apple-btn magnetic-btn inline-block will-change-transform"
