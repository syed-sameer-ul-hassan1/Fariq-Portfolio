rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /likes/counter {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['likes'])
                    && request.resource.data.likes is int
                    && request.resource.data.likes >= 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                    && (
                      request.resource.data.likes == resource.data.likes + 1
                      || (request.resource.data.likes == resource.data.likes - 1 && request.resource.data.likes >= 0)
                    );
      allow delete: if false;
    }
  }
}
